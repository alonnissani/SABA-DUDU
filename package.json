{
  "name": "saba-dudu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "סבא דודו — ארכיון משפחתי פרטי",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply saba-dudu-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply saba-dudu-db --remote",
    "deploy": "npm run build && npm run cf:deploy",
    "export-archive": "node scripts/export-archive.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "e2e:reset": "rm -rf .wrangler/state && wrangler d1 migrations apply saba-dudu-db --local",
    "cf:deploy": "(test -f dist/client/index.html || npm run build) && wrangler deploy && wrangler d1 migrations apply saba-dudu-db --remote",
    "cf:preview": "(test -f dist/client/index.html || npm run build) && wrangler versions upload"
  },
  "dependencies": {
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "hono": "^4.13.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^4.20251001.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "~4.1.12",
    "wrangler": "^4.151.1"
  }
}
